# ---- Server ----
PORT=3000
NODE_ENV=development
# Public URL of this API (used to build signed file links and payment return URLs)
APP_URL=http://localhost:3000
# Frontend origin allowed by CORS (comma-separated for several)
FRONTEND_ORIGIN=http://localhost:3001
# Frontend page the customer returns to after paying
FRONTEND_PAYMENT_RETURN_URL=http://localhost:3001/order/payment-result

# ---- Database ----
DATABASE_URL=postgresql://meko:meko@localhost:5432/meko?schema=public

# ---- Security (use long random strings in production: openssl rand -hex 32) ----
JWT_SECRET=change-me-jwt-secret
# Customer order-access token lifetime
CUSTOMER_TOKEN_TTL=24h
FILE_URL_SECRET=change-me-file-secret
# Signed file links lifetime in seconds
FILE_URL_TTL_SECONDS=900

# ---- Uploads ----
STORAGE_DIR=./storage
UPLOAD_MAX_MB=10

# ---- Payments ----
# mock = local development only. paymob = real gateway (to be completed once the brand picks a gateway).
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
