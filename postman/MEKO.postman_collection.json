    {
      "name": "5 · Dev only (محلي بس)",
      "description": "بيمثّل بوابة الدفع التجريبية (PAYMENT_PROVIDER=mock). مش بيشتغل في production.",
      "item": [
        {
          "name": "Dev · Confirm payment (mock webhook)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = JSON.stringify({",
                  "  paymentId: pm.environment.get('paymentId'),",
                  "  status: pm.environment.get('mockPaymentStatus') || 'PAID',",
                  "  amount: Number(pm.environment.get('paymentAmount'))",
                  "});",
                  "pm.environment.set('mockWebhookBody', body);",
                  "const sig = CryptoJS.HmacSHA256(body, pm.environment.get('webhookSecret')).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'x-mock-signature', value: sig });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/webhook/mock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "webhook",
                "mock"
              ]
            },
            "description": "بيأكد آخر payment اتعمل (paymentId). غيّري mockPaymentStatus لـ FAILED لتجربة فشل الدفع.",
            "body": {
              "mode": "raw",
              "raw": "{{mockWebhookBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
